# Neon Postgres connection string. Leave UNSET to run fully locally —
# the app falls back to a localStorage-backed function/config store.
# DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/rankcraft?sslmode=require"

# Where the browser loads Pyodide from. Defaults to the jsDelivr CDN.
# Point this at /pyodide/ if you vendor the runtime into public/.
# NEXT_PUBLIC_PYODIDE_URL="https://cdn.jsdelivr.net/pyodide/v0.26.4/full/"
